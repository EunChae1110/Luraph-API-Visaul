# Bind address (Windows + macOS)
HOST=127.0.0.1
PORT=8787

# Official Luraph API
LURAPH_API_BASE=https://api.lura.ph/v1

# SQLite history database
DATABASE_PATH=data/history.db

# Local obfuscation backups (survives Luraph 24h expiry)
BACKUP_DIR=data/backups

# Browser / Tauri origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,tauri://localhost,http://tauri.localhost
